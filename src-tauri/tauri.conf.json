{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRTS Terminal",
  "version": "0.1.0",
  "identifier": "prts.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && python src-tauri/build-sidecar.py",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PRTS Terminal",
        "width": 733,
        "height": 612,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.prts/session-files/**",
          "$HOME/.prts/uploads/**",
          "$HOME/.prts-dev/session-files/**",
          "$HOME/.prts-dev/uploads/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "AirsonVind",
    "resources": {
      "resources/arknights.db": "./",
      "src/knowledge/": "resources/knowledge/",
      "src/skills/": "resources/skills/",
      "src/docs/": "resources/docs/",
      "../LICENSE": "./LICENSE"
    },
    "externalBin": [
      "binaries/prts-maa-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "./windows/nsis-images/header.bmp",
        "sidebarImage": "./windows/nsis-images/sidebar.bmp",
        "customLanguageFiles": {
          "SimpChinese": "./windows/SimpChinese.nsh"
        },
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
