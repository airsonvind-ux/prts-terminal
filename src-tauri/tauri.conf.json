{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRTS Terminal",
  "version": "0.1.0",
  "identifier": "prts.terminal",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PRTS Terminal",
        "width": 733,
        "height": 612,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "dragDropEnabled": true,
        "alwaysOnTop": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.prts/session-files/**",
          "$HOME/.prts/uploads/**",
          "$HOME/.prts-dev/session-files/**",
          "$HOME/.prts-dev/uploads/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGRDhFRUJDRUIzNkYxNzUKUldSMThUYnJ2TzdZZjN0WlpxM0dXT3h6RVJvNXBOSjZYRXNOU01JOVJPa2doamRJcis2ZUlsYlQK",
      "endpoints": [
        "https://gitee.com/airsonvind0/prts-terminal-release/raw/master/latest.json",
        "https://github.com/AirsonVInd0/prts-terminal-release/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "manualDownloadUrl": "https://gitee.com/airsonvind0/prts-terminal-release/releases",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "publisher": "AirsonVind",
    "resources": {
      "resources/arknights.db": "./",
      "resources/DATA_MANIFEST.json": "./DATA_MANIFEST.json",
      "content/knowledge/": "resources/knowledge/",
      "content/skills/": "resources/skills/",
      "content/docs/": "resources/docs/",
      "../LICENSE": "./LICENSE",
      "../DATA_NOTICE.md": "./DATA_NOTICE.md",
      "../bridge/LICENSE": "./LICENSES/bridge-AGPL-3.0.txt",
      "../THIRD_PARTY_NOTICES.md": "./THIRD_PARTY_NOTICES.md"
    },
    "externalBin": [
      "binaries/prts-maa-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "./windows/nsis-images/header.bmp",
        "sidebarImage": "./windows/nsis-images/sidebar.bmp",
        "customLanguageFiles": {
          "SimpChinese": "./windows/SimpChinese.nsh"
        },
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
